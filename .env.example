# Copy this file to .env.local and fill in the values. Do not put real values here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# M-Pesa (Daraja). All server only. Never add NEXT_PUBLIC_ to these names.
# MPESA_ENV is "sandbox" for testing or "production" for real money.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode is 174379. The sandbox passkey is on the Daraja simulator page.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline for a paybill, CustomerBuyGoodsOnline for a till.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Where the money goes. Same as the shortcode for a paybill, the till number for a till.
MPESA_PARTY_B=174379
# Random text protecting the payment callback address.
MPESA_CALLBACK_SECRET=
# Your site's public https address, e.g. https://sky254.co.ke. Safaricom sends payment
# results here, and canonical links, the sitemap and the Google product feed use it.
SITE_URL=

# New order emails (optional, from resend.com). Without these, orders still appear in the dashboard.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=

# Analytics and ads (optional). Each loads only when its ID is set. Safe for the browser.
# In GA4, turn off Admin > Data streams > Enhanced measurement > "Page changes based on
# browser history events": the site sends its own page views and skips private order pages.
NEXT_PUBLIC_GA4_ID=
# Google Ads: the AW- ID, and the label of your "Purchase" conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
NEXT_PUBLIC_META_PIXEL_ID=
